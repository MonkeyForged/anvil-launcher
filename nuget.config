<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Cleared first: a user-wide source (a company feed, a local cache folder) must not
         change what this repository restores from. -->
    <clear />
    <!-- The design package lives in the repository itself, so a build needs no account and no
         token (docs/architecture.md section 4.6). The path is relative to this file. -->
    <add key="packages" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- MonkeyForged.* comes from packages/ and nowhere else: with the folder missing, restore
       fails naming the package instead of searching nuget.org for a package of that name.
       Everything else comes from nuget.org as before. -->
  <packageSourceMapping>
    <packageSource key="packages">
      <package pattern="MonkeyForged.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
