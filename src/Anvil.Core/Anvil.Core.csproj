<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <!--
      The session bus probes (Tray/StatusNotifierProbe.cs, Sessions/SessionBusNameProbe.cs).
      Exactly the version Avalonia.FreeDesktop brings into the app: NuGet resolves the app to the
      higher one, and the core then runs against a library it was not compiled for (spec s15.2;
      DBusLibraryTests in Anvil.App.Tests keeps both equal).
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

</Project>
