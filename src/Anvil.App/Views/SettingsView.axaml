<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anvil.App.ViewModels"
             xmlns:views="using:Anvil.App.Views"
             xmlns:mf="using:MonkeyForged.Design.Avalonia"
             xmlns:sys="using:System"
             x:Class="Anvil.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <!--
    A module card's content (S3.4, Spec E-8): the Core draws the frame, the module supplies the
    section — the DataTemplate makes the assignment via the concrete type, the same fixed
    assignment as with the sections of the GAME card (LibraryView) and the main window's pages.
    No ViewLocator.

    It sits up here, not inside the card's ContentControl: there it would live in the
    ItemTemplate and be rebuilt for every card.

    The look (story s13.1, Theme/Styles/Settings.axaml): every card is drawn like the package's
    HUD panel, every box (selection row, Dependencies entry) is the inset box of the element
    description §8 — bg-void, frame line, 12 × 16 inside, its parts 8 apart. The parts after the
    head row carry that gap as their own top margin, so a hidden part leaves no gap.
  -->
  <UserControl.DataTemplates>
    <!--
      The fetch (Spec S3.5b §3.5–§3.7, element description §8.1): first the red sentence, then
      the package's meter — 20 segments, the percent alone above them — and Cancel in signal. ONE
      drawing for both the entry and the selection row, because both hold the same
      FetchProgressViewModel. The header row's action hides the ViewModel itself while fetching.
    -->
    <DataTemplate DataType="vm:FetchProgressViewModel">
      <StackPanel>
        <TextBlock Classes="fetch-error" Text="{Binding ErrorText}"
                   IsVisible="{Binding HasError}" />
        <Grid Classes="fetch-row" ColumnDefinitions="*,Auto" ColumnSpacing="16"
              IsVisible="{Binding IsRunning}">
          <!-- The percent as the ViewModel words it (42%): the meter's own text pads to 042%. -->
          <mf:Meter Grid.Column="0" Minimum="0" Maximum="100"
                    Value="{Binding Percent}" ValueText="{Binding PercentText}" />
          <Button Grid.Column="1" Classes="small fetch-cancel" Command="{Binding CancelCommand}"
                  Content="{x:Static vm:FetchProgressViewModel.CancelLabel}" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:PackagePickRowViewModel">
      <!--
        The selection row with state (Spec S3.5b §3.7, plan §8.2), its own template since s9.1
        (I-4) so every module section draws it the same way: title and subline on the
        left, below it the box in the same shape as an entry of the Dependencies card — name,
        field, state, action, sentence, expandable files. The function stays different: here
        Anvil asks, there it reports (concept, follow-up 2026-09-15).
      -->
      <Border Classes="card-row">
        <StackPanel Spacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Label}" Classes="row-label" />
            <TextBlock Text="{Binding Sub}" Classes="card-row-sub" />
          </StackPanel>

          <Border Classes="dep-box">
            <StackPanel>
              <Grid Classes="box-head" ColumnDefinitions="*,Auto,Auto">
                <WrapPanel VerticalAlignment="Center" ItemSpacing="12" LineSpacing="4">
                  <TextBlock Text="{Binding BoxName}" Classes="dep-name" />

                  <!--
                    The package's combo box at the small measure (element description §8: mono
                    14 px, 4 × 10 inside), as wide as its value. The closed field shows the
                    name alone; the rich entry with mark, separator and empty sentence applies
                    only in the list.

                    IsDropDownOpen is bound two-way to the ViewModel: this — and only this —
                    carries the re-read of the store on expanding. There is no watcher on the
                    folder (S3.3), and the user drops packages into it while Anvil is running.
                    Do not "clean up": without this binding the list shows the earlier state
                    until the next start.
                  -->
                  <ComboBox Classes="settings-choice" VerticalAlignment="Center"
                            Classes.none="{Binding SelectedChoice.IsNone}"
                            ItemsSource="{Binding Choices}"
                            SelectedItem="{Binding SelectedChoice}"
                            IsDropDownOpen="{Binding IsListOpen, Mode=TwoWay}">
                    <ComboBox.SelectionBoxItemTemplate>
                      <DataTemplate DataType="vm:PackageChoice">
                        <TextBlock Classes="settings-choice-value" Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:PackageChoice">
                        <StackPanel>
                          <!-- The chosen entry carries the forge square; "none selected" never does. -->
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Rectangle Classes="settings-choice-mark">
                              <Rectangle.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                  <Binding Path="$parent[ComboBoxItem].IsSelected" />
                                  <Binding Path="!IsNone" />
                                </MultiBinding>
                              </Rectangle.IsVisible>
                            </Rectangle>
                            <!-- A vendor build in forge-hot: it is fetched, not chosen. -->
                            <TextBlock Classes="settings-choice-name"
                                       Classes.none="{Binding IsNone}"
                                       Classes.vendor="{Binding IsVendor}"
                                       Text="{Binding Label}" />
                          </StackPanel>

                          <!--
                            "none selected" sits at the top, with a separator line below it —
                            where the Proton list has "Auto", and for the same reason: the
                            line says that this entry is not a file, but its absence.
                          -->
                          <Border Classes="settings-choice-separator" IsVisible="{Binding IsNone}" />

                          <!--
                            The empty sentence of the open list. It hangs off the topmost
                            entry, because that is the only one when the store is empty — the
                            alternative would be its own template for the whole ComboBox, just
                            to fit one line below the list.
                          -->
                          <TextBlock Classes="choice-empty"
                                     Text="{x:Static vm:PackagePickRowViewModel.EmptyNote}"
                                     IsVisible="{Binding StoreIsEmpty}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </WrapPanel>

                <!--
                  Every stage of obtaining with a forge square, as in the entry. The square
                  pulses while the row waits — installer open, checking (design 27,
                  Settings-CeBezug).
                -->
                <StackPanel Grid.Column="1" Classes="dep-state-line">
                  <Rectangle Classes="dep-dot"
                             Classes.is-waiting="{Binding IsWaiting}"
                             IsVisible="{Binding IsBusy}" />
                  <!-- Forge-hot while fetching and while the installer is open; checking stays muted. -->
                  <TextBlock Classes="dep-state"
                             Classes.warning="{Binding IsStateWarning}"
                             Classes.active="{Binding IsStateActive}"
                             Text="{Binding StateText}" />
                </StackPanel>

                <!-- Disabled through the command while a tool is missing (design 65). -->
                <Button Grid.Column="2" Classes="small box-action"
                        IsVisible="{Binding ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Command="{Binding ActionCommand}">
                  <TextBlock Text="{Binding ActionText, Converter={x:Static mf:UppercaseTextConverter.Instance}}" />
                </Button>
              </Grid>

              <!--
                The sentence, with its one word set apart (Decline, bubblewrap); next to it the
                stage's Cancel while the installer is open (Settings-CeBezug).
              -->
              <Grid Classes="box-part" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                    IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Grid.Column="0" Classes="dep-note"
                           views:EmphasizedInlines.EmphasisForeground="{StaticResource InkBrush}"
                           views:EmphasizedInlines.Emphasis="{Binding NoteEmphasis}"
                           views:EmphasizedInlines.Text="{Binding Note}" />
                <Button Grid.Column="1" Classes="small fetch-cancel"
                        IsVisible="{Binding ShowsStageCancel}"
                        Command="{Binding CancelStageCommand}"
                        Content="{x:Static vm:FetchProgressViewModel.CancelLabel}" />
              </Grid>

              <ContentControl Content="{Binding Fetch}" />

              <!-- A row without a file list (CE Bridge, design 58) has no toggle either. -->
              <ToggleButton Classes="disclosure"
                            IsChecked="{Binding IsFilesOpen, Mode=TwoWay}">
                <ToggleButton.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="HasFiles" />
                    <Binding Path="ShowsFileList" />
                  </MultiBinding>
                </ToggleButton.IsVisible>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="disclosure-chevron" />
                  <TextBlock Text="{Binding FilesToggleText, Converter={x:Static mf:UppercaseTextConverter.Instance}}" />
                </StackPanel>
              </ToggleButton>

              <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsFilesOpen" />
                    <Binding Path="HasFiles" />
                    <Binding Path="ShowsFileList" />
                  </MultiBinding>
                </ItemsControl.IsVisible>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:PickFileViewModel">
                    <Border Classes="dep-part-row">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Panel Grid.Column="0" Classes="part-mark-box">
                          <Rectangle Classes="part-mark" Classes.present="{Binding InUse}" />
                          <Path Classes="part-tick" IsVisible="{Binding InUse}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Classes="part-name file"
                                   Classes.present="{Binding InUse}"
                                   Text="{Binding Name}" />
                        <TextBlock Grid.Column="2" Classes="part-status"
                                   Text="{Binding Status}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:WandBridgeSettingsViewModel">
      <StackPanel>

        <!--
          The selection row "Wand version", drawn by the PackagePickRowViewModel template above
          (s9.1 I-4).
        -->
        <ContentControl Content="{Binding Pick}" />

        <!--
          The switch row (spec s7.2, delivery §3.5): the Core card's switch, unchanged. It sits
          between choice and door — order need → choice → switch → doors, because a switch below
          a door would look as if it belonged to the folder.
        -->
        <Border Classes="card-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Static vm:WandBridgeSettingsViewModel.LookUpOnlineLabel}"
                         Classes="row-label" />
              <TextBlock Text="{x:Static vm:WandBridgeSettingsViewModel.LookUpOnlineSub}"
                         Classes="card-row-sub" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" Classes="switch"
                          IsChecked="{Binding LookUpOnline}" />
          </Grid>
        </Border>

        <!--
          The store is an ACTION ROW, not a path field (design follow-up of 2026-09-13): the
          user does not set the path — the data root dictates it, every module gets its folder
          underneath. A "Change" button would claim the opposite.
        -->
        <Border Classes="card-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Static vm:WandBridgeSettingsViewModel.StorageLabel}"
                         Classes="row-label" />
              <TextBlock Text="{x:Static vm:WandBridgeSettingsViewModel.StorageSub}"
                         Classes="card-row-sub" />
            </StackPanel>
            <Button Grid.Column="1" Classes="small" Content="Open folder"
                    Command="{Binding OpenFolderCommand}" />
          </Grid>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:CeBridgeSettingsViewModel">
      <StackPanel>

        <!-- The selection row "CE version", drawn by the PackagePickRowViewModel template above. -->
        <ContentControl Content="{Binding Pick}" />

        <!-- The store as an action row, like at Wand Bridge: the data root dictates the path. -->
        <Border Classes="card-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Static vm:CeBridgeSettingsViewModel.StorageLabel}"
                         Classes="row-label" />
              <TextBlock Text="{x:Static vm:CeBridgeSettingsViewModel.StorageSub}"
                         Classes="card-row-sub" />
            </StackPanel>
            <Button Grid.Column="1" Classes="small" Content="Open folder"
                    Command="{Binding OpenFolderCommand}" />
          </Grid>
        </Border>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <!-- The border hangs off the content, not the ScrollViewer (reasoning in LibraryView). -->
    <ScrollViewer Padding="0">
    <!-- 660 px as in the mockup; the window is at least 1000 px wide, so this always fits. -->
    <StackPanel x:Name="SettingsColumn" Spacing="16" Width="660" HorizontalAlignment="Left"
                Margin="24">
      <StackPanel Spacing="8" Margin="0,0,0,8">
        <mf:AppHeader Heading="{Binding Title}" />
        <TextBlock Text="{Binding Subtitle}" Classes="page-subtitle" />
      </StackPanel>

      <!--
        Core card (element description §8): a HUD panel that folds — arrow and name in the head,
        on the right the key as code and the tag Core in forge. Folded, only the head stands.
      -->
      <mf:ChamferBorder Classes="card settings-card">
        <StackPanel>
          <Button Classes="card-head" Classes.expanded="{Binding IsCardExpanded}"
                  Command="{Binding ToggleCardCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Path Grid.Column="0" Classes="card-chevron"
                    Classes.collapsed="{Binding !IsCardExpanded}" />
              <TextBlock Grid.Column="1" Text="{Binding CardTitle}" Classes="card-heading" />
              <TextBlock Grid.Column="2" Classes="card-code"
                         Text="{Binding CardKey, Converter={x:Static mf:UppercaseTextConverter.Instance}}" />
              <mf:Tag Grid.Column="3" Classes="forge" Content="{Binding CardTag}" />
            </Grid>
          </Button>
          <Panel Classes="card-body" IsVisible="{Binding IsCardExpanded}">
            <StackPanel>
              <Border Classes="card-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Start on boot" Classes="row-label" />
                    <TextBlock Text="Anvil launches with the session." Classes="card-row-sub" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" Classes="switch"
                                IsChecked="{Binding StartOnBoot}" />
                </Grid>
              </Border>
              <Border Classes="card-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Minimize to tray" Classes="row-label" />
                    <TextBlock Text="Closing keeps the app in the tray." Classes="card-row-sub" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" Classes="switch"
                                IsChecked="{Binding MinimizeToTray}" />
                </Grid>
              </Border>
              <Border Classes="card-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Data location" Classes="row-label" />
                    <TextBlock Text="Module files live here, one folder per module."
                               Classes="card-row-sub" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding DataLocation}" Classes="path"
                               ToolTip.Tip="{Binding DataLocation}" />
                    <Button Classes="small" Content="Change"
                            Command="{Binding ChangeDataLocationCommand}" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Action row: the third row type (elements §8, design requirement 22). -->
              <Border Classes="card-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding BackupsLabel}" Classes="row-label" />
                    <TextBlock Text="{Binding BackupsSub}" Classes="card-row-sub" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="small" Content="Manage"
                          Command="{Binding Backups.OpenCommand}" />
                </Grid>
              </Border>
            </StackPanel>
          </Panel>
        </StackPanel>
      </mf:ChamferBorder>

      <!--
        The Dependencies card (Spec S3.5b §3.6): the same card shape as above, tag Core,
        collapsed on build. Every component the installed modules need stands here exactly
        once — the module cards point here with "Show in Dependencies", and the code-behind
        scrolls the card into view via x:Name.
      -->
      <mf:ChamferBorder Classes="card settings-card" x:Name="DependenciesCard"
                        DataContext="{Binding Dependencies}"
                        x:DataType="vm:DependenciesViewModel">
        <StackPanel>
          <Button Classes="card-head" Classes.expanded="{Binding IsCardExpanded}"
                  Command="{Binding ToggleCardCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Path Grid.Column="0" Classes="card-chevron"
                    Classes.collapsed="{Binding !IsCardExpanded}" />
              <TextBlock Grid.Column="1" Text="{x:Static vm:DependenciesViewModel.CardTitle}"
                         Classes="card-heading" />
              <TextBlock Grid.Column="2" Classes="card-code"
                         Text="{Binding Source={x:Static vm:DependenciesViewModel.CardKey}, Converter={x:Static mf:UppercaseTextConverter.Instance}}" />
              <mf:Tag Grid.Column="3" Classes="forge"
                      Content="{x:Static vm:DependenciesViewModel.CardTag}" />
            </Grid>
          </Button>
          <Panel Classes="card-body" IsVisible="{Binding IsCardExpanded}">
            <StackPanel>
              <Border Classes="card-row">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static vm:DependenciesViewModel.ComponentsLabel}"
                               Classes="row-label" />
                    <TextBlock Text="{Binding ComponentsSub}" Classes="card-row-sub" />
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <!-- The gap between two boxes: the concept draws only one. -->
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <!-- An entry's box (plan §8.1, concept depsRow). No fixed size. -->
                      <DataTemplate DataType="vm:DependencyEntryViewModel">
                        <Border Classes="dep-box">
                          <StackPanel>
                            <Grid Classes="box-head" ColumnDefinitions="*,Auto,Auto">
                              <WrapPanel VerticalAlignment="Center" ItemSpacing="12" LineSpacing="4">
                                <TextBlock Text="{Binding Name}" Classes="dep-name" />
                                <ComboBox Classes="settings-choice" VerticalAlignment="Center"
                                          IsVisible="{Binding HasVersionChoice}"
                                          ItemsSource="{Binding Versions}"
                                          SelectedItem="{Binding SelectedVersion}">
                                  <ComboBox.SelectionBoxItemTemplate>
                                    <DataTemplate DataType="sys:String">
                                      <TextBlock Classes="settings-choice-value" Text="{Binding}" />
                                    </DataTemplate>
                                  </ComboBox.SelectionBoxItemTemplate>
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="sys:String">
                                      <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Rectangle Classes="settings-choice-mark"
                                                   IsVisible="{Binding $parent[ComboBoxItem].IsSelected}" />
                                        <TextBlock Classes="settings-choice-name" Text="{Binding}" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- One version: no field with one entry, just the value in mono (§8.1). -->
                                <TextBlock Classes="dep-version"
                                           IsVisible="{Binding !HasVersionChoice}"
                                           Text="{Binding SelectedVersion}" />
                              </WrapPanel>

                              <!--
                                The state as text without a surface; a forge square in front while
                                something runs. Forge-hot only while fetching — checking stands
                                muted with its square, as drawn.
                              -->
                              <StackPanel Grid.Column="1" Classes="dep-state-line">
                                <Rectangle Classes="dep-dot" IsVisible="{Binding ShowsActivityDot}" />
                                <TextBlock Classes="dep-state" Text="{Binding StateText}"
                                           Classes.warning="{Binding IsStateWarning}"
                                           Classes.active="{Binding Fetch.IsRunning}" />
                              </StackPanel>

                              <Button Grid.Column="2" Classes="small box-action"
                                      IsVisible="{Binding CanGetMissingFiles}"
                                      Command="{Binding GetMissingFilesCommand}">
                                <TextBlock Text="{Binding Source={x:Static vm:DependencyEntryViewModel.GetMissingFilesLabel}, Converter={x:Static mf:UppercaseTextConverter.Instance}}" />
                              </Button>
                            </Grid>

                            <!-- While fetching the meter takes the sub-line's place (§8.1). -->
                            <TextBlock Classes="dep-note box-part" Text="{Binding Note}">
                              <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                  <Binding Path="Note" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                  <Binding Path="!Fetch.IsRunning" />
                                </MultiBinding>
                              </TextBlock.IsVisible>
                            </TextBlock>
                            <ContentControl Content="{Binding Fetch}" />
                            <TextBlock Classes="dep-note box-part" Text="{Binding SharedText}"
                                       IsVisible="{Binding SharedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <ToggleButton Classes="disclosure" IsVisible="{Binding HasParts}"
                                          IsChecked="{Binding IsPartsOpen, Mode=TwoWay}">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="disclosure-chevron" />
                                <TextBlock Text="{Binding PartsToggleText, Converter={x:Static mf:UppercaseTextConverter.Instance}}" />
                              </StackPanel>
                            </ToggleButton>

                            <ItemsControl ItemsSource="{Binding Parts}">
                              <ItemsControl.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                  <Binding Path="IsPartsOpen" />
                                  <Binding Path="HasParts" />
                                </MultiBinding>
                              </ItemsControl.IsVisible>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DependencyPartViewModel">
                                  <Border Classes="dep-part-row">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                      <Panel Grid.Column="0" Classes="part-mark-box">
                                        <Rectangle Classes="part-mark"
                                                   Classes.present="{Binding IsPresent}" />
                                        <Path Classes="part-tick" IsVisible="{Binding IsPresent}" />
                                      </Panel>
                                      <TextBlock Grid.Column="1" Classes="part-name"
                                                 Classes.present="{Binding IsPresent}"
                                                 Text="{Binding Name}" />
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="card-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static vm:DependenciesViewModel.StorageLabel}"
                               Classes="row-label" />
                    <TextBlock Text="{x:Static vm:DependenciesViewModel.StorageSub}"
                               Classes="card-row-sub" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="small"
                          Content="{x:Static vm:DependenciesViewModel.OpenFolderLabel}"
                          Command="{Binding OpenFolderCommand}" />
                </Grid>
              </Border>
            </StackPanel>
          </Panel>
        </StackPanel>
      </mf:ChamferBorder>

      <!--
        The module cards (S3.4, Spec E-8): the same card shape as above — chevron, title, key,
        tag —, only the tag says `Module` and stays neutral, and the card stands COLLAPSED
        (mockup: only core.app is open). The Core draws the frame, the module supplies the
        content; the ContentControl does not know what it shows.
        The list is empty as long as no module has a section or a need — then nothing stands
        here, and that is not an empty state: the page always carries the Core card.
      -->
      <ItemsControl ItemsSource="{Binding ModuleCards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="16" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:ModuleSettingsCardViewModel">
            <mf:ChamferBorder Classes="card settings-card">
              <StackPanel>
                <Button Classes="card-head" Classes.expanded="{Binding IsCardExpanded}"
                        Command="{Binding ToggleCardCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Path Grid.Column="0" Classes="card-chevron"
                          Classes.collapsed="{Binding !IsCardExpanded}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="card-heading" />
                    <TextBlock Grid.Column="2" Classes="card-code"
                               Text="{Binding Key, Converter={x:Static mf:UppercaseTextConverter.Instance}}" />
                    <!-- Grey means off: forge while the module is on, neutral when it is off (s15.7). -->
                    <mf:Tag Grid.Column="3" Classes.forge="{Binding IsModuleEnabled}"
                            Content="{Binding Tag}" />
                  </Grid>
                </Button>
                <Panel Classes="card-body" IsVisible="{Binding IsCardExpanded}">
                  <StackPanel>
                    <!--
                      The Core draws the need lines, not the module (Spec S3.5b §3.7,
                      E-5) — above the section, one per required component.
                    -->
                    <ItemsControl ItemsSource="{Binding NeedLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:NeedLineViewModel">
                          <Border Classes="card-row">
                            <Grid Classes="need-line" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                              <!-- Satisfied: a forge square with a tick; missing: a warning square. -->
                              <Panel Grid.Column="0" Classes="need-mark-box">
                                <Rectangle Classes="need-mark"
                                           Classes.warning="{Binding IsWarning}" />
                                <Path Classes="need-check" IsVisible="{Binding !IsWarning}" />
                              </Panel>
                              <TextBlock Grid.Column="1" Classes="need-text"
                                         Classes.warning="{Binding IsWarning}"
                                         Text="{Binding Text}" />
                              <Button Grid.Column="2" Classes="text-link"
                                      Command="{Binding ShowInDependenciesCommand}">
                                <TextBlock Text="{x:Static vm:NeedLineViewModel.ShowLabel}" />
                              </Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentControl Content="{Binding Section}" IsVisible="{Binding HasSection}" />
                  </StackPanel>
                </Panel>
              </StackPanel>
            </mf:ChamferBorder>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </ScrollViewer>

    <!-- The backups list and its details (Spec S4.7 §3.5, S4.8 §3.7), its own view since s13.1. -->
    <views:BackupsOverlay />

    <!--
      The confirmation before restoring — the same shape as the stop confirmation (§4.1), with
      swapped texts; a window of its own since story s14.1, modal over the main window and so
      over the backups list it asks about. Closing the window is "Keep current". Restoring
      starts something, so the dialog carries the class "starting" (forge confirm,
      Theme/Styles/Dialogs.axaml).
    -->
    <views:DialogPresenter IsOpen="{Binding Backups.IsAsking}"
                           CancelCommand="{Binding Backups.KeepCurrentCommand}">
      <views:DialogPresenter.DialogContent>
        <Border Classes="dialog starting">
          <StackPanel>
            <TextBlock Classes="dialog-title" Text="{Binding Backups.AskTitle}" />
            <TextBlock Classes="dialog-text"
                       Text="Steam will restart. Everything Steam saved to this file since then is lost." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9">
              <Button Classes="dialog-cancel" Content="Keep current"
                      Command="{Binding Backups.KeepCurrentCommand}" />
              <Button Classes="dialog-confirm" Content="Restore"
                      Command="{Binding Backups.ConfirmRestoreCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </views:DialogPresenter.DialogContent>
    </views:DialogPresenter>

    <!--
      The page's confirmation (s9.3, design 61) — the form of the stop confirmation in the
      library, a window of its own since story s14.1, 420 wide as on sheet Settings-CeBezug.
      Closing the window answers Cancel; no button grabs focus, Enter does nothing. Title, text
      and labels come from the module's request; the text has one word set apart (Decline), in
      ink as well as weighted (Settings-CeBezug). Opening the installer starts something: class
      "starting", as above.
    -->
    <views:DialogPresenter IsOpen="{Binding Confirmation.IsPending}"
                           CancelCommand="{Binding Confirmation.CancelCommand}"
                           DialogWidth="420">
      <views:DialogPresenter.DialogContent>
        <Border Classes="dialog starting">
          <StackPanel>
            <TextBlock Classes="dialog-title" Text="{Binding Confirmation.Pending.Title}" />
            <TextBlock Classes="dialog-text"
                       views:EmphasizedInlines.EmphasisForeground="{StaticResource InkBrush}"
                       views:EmphasizedInlines.Emphasis="{Binding Confirmation.Pending.Text.Emphasis}"
                       views:EmphasizedInlines.Text="{Binding Confirmation.Pending.Text.Text}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9">
              <Button Classes="dialog-cancel" Content="{Binding Confirmation.Pending.CancelLabel}"
                      Command="{Binding Confirmation.CancelCommand}" />
              <Button Classes="dialog-confirm" Content="{Binding Confirmation.Pending.ConfirmLabel}"
                      Command="{Binding Confirmation.ConfirmCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </views:DialogPresenter.DialogContent>
    </views:DialogPresenter>
  </Panel>
</UserControl>
