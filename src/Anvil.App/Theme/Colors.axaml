<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The tones Anvil derives from the design package (MonkeyForged.Design.Avalonia,
    Generated/Tokens.axaml). Every other colour of the app is a token of the package, referenced
    directly (spec s13.1, decisions: Anvil's own colour keys were references to the tokens while
    the areas moved over, and went once no area used them). A tone the package knows only as a
    base colour is a brush from the token colour with an opacity — the tone stays the package's.
    No colour literal in this file or anywhere else in the app (spec s13.1, UC-18; test
    ThemeLiteralTests).

    The tokens must be merged before this file (App.axaml): StaticResource resolves at load.
  -->

  <!-- The scrim behind a dialog and the backups overlay: the void, darkened as in 1.2.1. -->
  <SolidColorBrush x:Key="AnvilScrim" Color="{StaticResource BgVoidColor}" Opacity="0.68" />

  <!--
    The About window's watermark (sheet 00f-about): ink at 7 %, drawn through the package's logo as
    its opacity mask. The 7 % sit on the brush, not on the element: an element's Opacity together
    with an OpacityMask left the logo invisible (measured in a headless render, story s14.1).
  -->
  <SolidColorBrush x:Key="AnvilWatermark" Color="{StaticResource InkColor}" Opacity="0.07" />
</ResourceDictionary>
