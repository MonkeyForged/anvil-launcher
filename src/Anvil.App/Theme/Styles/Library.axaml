<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mf="using:MonkeyForged.Design.Avalonia"
        xmlns:views="using:Anvil.App.Views">
  <!--
    The library (sheets 00-library, 00b-00e): its header, the game cards and their context menu.
    Measures and tokens from docs/design/sources/Main.dc.html; the reasons in
    docs/design/delivery.md §3.1.
  -->
  <Styles.Resources>
    <!--
      The status band of a running card: success at 10 % over the card's bg-raised, as the
      sheet mixes it (spec s13.1). The package knows success only as a full tone.
    -->
    <SolidColorBrush x:Key="GameCardBandBrush" Color="{StaticResource SuccessColor}" Opacity="0.1" />
  </Styles.Resources>

  <!-- Header: 24 around, 16 below; 16 between the AppHeader and the search row (sheet 00-library). -->
  <Style Selector="StackPanel.library-head">
    <Setter Property="Margin" Value="24,24,24,16" />
    <Setter Property="Spacing" Value="16" />
  </Style>

  <!--
    Rescan is the package's small secondary button. The shared rule Button.small (Common) colours
    every small button neutrally; this one gets the package's forge frame back.
  -->
  <Style Selector="Button.small.rescan, Button.small.rescan:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource ForgeBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForgeHotBrush}" />
  </Style>
  <!-- Sheet: a 14 px icon of a 24 grid, stroke 2.2 — the drawn part is 10.5 px, its stroke 1.3. -->
  <Style Selector="Path.rescan-icon">
    <Setter Property="Width" Value="10.5" />
    <Setter Property="Height" Value="10.5" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Square" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    Search field: the package's text box with 38 on the left for the magnifier that lies over it
    (sheet: icon 16 px at 12 from the left, drawn part 10.7 px, stroke 1.3).
  -->
  <Style Selector="TextBox.library-search">
    <Setter Property="Padding" Value="38,10,12,10" />
  </Style>
  <Style Selector="Path.search-icon">
    <Setter Property="Width" Value="10.7" />
    <Setter Property="Height" Value="10.7" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{StaticResource InkMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Square" />
    <Setter Property="Margin" Value="15,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!--
    The game card is a button, so that click, keyboard and focus come from the frame and do
    not have to be rebuilt; the bare look takes the package's button face off it. Its content
    stretches both ways: the grid gives every card of a row the row's height.
  -->
  <Style Selector="Button.game-card">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!--
    The HUD panel's frame (package: Themes/HudPanel.axaml): 1 px, chamfer-md at top right and
    bottom left, bg-raised inside. Hover lifts the frame to line-strong; the selection is the
    package's highlight — frame forge — and comes last, so it stays under the pointer. No line
    carries the run any more: that is the status band (design delivery §2.1).
  -->
  <Style Selector="mf|ChamferBorder.game-card-frame">
    <Setter Property="Cut" Value="{StaticResource ChamferMd}" />
    <Setter Property="Corners" Value="TopRight, BottomLeft" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
  </Style>
  <Style Selector="Button.game-card:pointerover mf|ChamferBorder.game-card-frame">
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
  </Style>
  <Style Selector="Button.game-card.is-selected mf|ChamferBorder.game-card-frame">
    <Setter Property="BorderBrush" Value="{StaticResource ForgeBrush}" />
  </Style>

  <!-- Head: name and platform word 16 inside, 12 above and below, a line under it. -->
  <Style Selector="Border.game-card-head">
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
  </Style>
  <Style Selector="Border.game-card-bar">
    <Setter Property="Width" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{StaticResource ForgeBrush}" />
  </Style>
  <!-- Text style h3 on one line, cut with an ellipsis (element description §3). -->
  <Style Selector="TextBlock.game-card-name">
    <Setter Property="Margin" Value="16,12,0,12" />
    <Setter Property="FontFamily" Value="{StaticResource TextH3FontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource TextH3FontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource TextH3LineHeight}" />
    <Setter Property="FontWeight" Value="{StaticResource TextH3FontWeight}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!--
    The platform word in the text style label. The top margin puts its baseline on the name's,
    as the panel aligns them (board CSS: align-items baseline); measured on the rendered sheet.
  -->
  <Style Selector="TextBlock.game-card-platform">
    <Setter Property="Margin" Value="12,20,16,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="FontFamily" Value="{StaticResource TextLabelFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource TextLabelFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource TextLabelLineHeight}" />
    <Setter Property="FontWeight" Value="{StaticResource TextLabelFontWeight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource TextLabelLetterSpacing}" />
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
  </Style>
  <Style Selector="Button.game-card.is-selected TextBlock.game-card-platform">
    <Setter Property="Foreground" Value="{StaticResource ForgeHotBrush}" />
  </Style>

  <!-- Artwork: without an image the neutral surface of the sheet. -->
  <Style Selector="views|AspectPanel.game-card-art">
    <Setter Property="Background" Value="{StaticResource BgOverlayBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!--
    Status band (spec s13.1, delivery §3.1): lies under the status row and fills it to the frame,
    cut at the bottom left like the frame's inside (12 less the 1 px frame); a 1 px success edge
    at its top, flush under the artwork.
  -->
  <Style Selector="mf|ChamferBorder.game-card-band">
    <Setter Property="Cut" Value="11" />
    <Setter Property="Corners" Value="BottomLeft" />
    <Setter Property="Background" Value="{StaticResource GameCardBandBrush}" />
  </Style>
  <Style Selector="Border.game-card-band-edge">
    <Setter Property="Height" Value="1" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
  </Style>
  <!--
    The status row: 12 above, 16 at the sides and below; at least a tag's height (18), so a card
    without tags is as tall as one with them.
  -->
  <Style Selector="Grid.game-card-status">
    <Setter Property="Margin" Value="16,12,16,16" />
    <Setter Property="MinHeight" Value="18" />
  </Style>

  <!--
    The star in the status row. A button inside a button: Avalonia's Button marks
    PointerPressed as handled, so the event does not reach the card below — this is the
    counterpart of stopPropagation() in the concept. As tall as the row, so the card does not
    grow by it.
  -->
  <Style Selector="Button.star">
    <Setter Property="Theme" Value="{StaticResource BareButton}" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!--
    Sheet: a 16 px icon of a 24 grid, stroke 1.8, round joins. Only the height is set: the star is not
    square (17 × 16.2), and a set width would leave the slack of the uniform scale on one side.
    Off: an outline in ink-muted, ink under the pointer; on: filled forge-hot — last, so it
    stays under the pointer.
  -->
  <Style Selector="Path.star">
    <Setter Property="Height" Value="10.8" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{StaticResource InkMutedBrush}" />
  </Style>
  <Style Selector="Button.star:pointerover Path.star">
    <Setter Property="Stroke" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Path.star.is-favorite">
    <Setter Property="Fill" Value="{StaticResource ForgeHotBrush}" />
    <Setter Property="Stroke" Value="{StaticResource ForgeHotBrush}" />
  </Style>

  <!--
    Context menu of the game card (element description §9): the package's menu — surface,
    frame, shadow, 32 px rows, hover and the locked ink-faint come from its theme
    (Themes/Menu.axaml). Here only what the card's menu adds: its width, the module captions,
    the rules between the groups and the colour rule as text.
  -->
  <Style Selector="ContextMenu">
    <Setter Property="MinWidth" Value="240" />
  </Style>
  <!-- Sheet: 12 at the sides (Fluent's entry keeps 11). -->
  <Style Selector="ContextMenu > MenuItem">
    <Setter Property="Padding" Value="12,4,12,7" />
  </Style>
  <!--
    No entry of the card's menu has a shortcut. Fluent's empty shortcut text would still give
    caption and rule a line of body height, and its column, shared by all rows, would keep the
    rule 24 off the right edge.
  -->
  <Style Selector="ContextMenu > MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!--
    Caption and divider are rows like any other and therefore MenuItem — locked, so that they
    can neither be hovered nor clicked. Caption: text style label in ink-faint, 8 above, 2 below.
  -->
  <Style Selector="ContextMenu > MenuItem.caption">
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ContextMenu > MenuItem.caption /template/ Border#PART_LayoutRoot">
    <Setter Property="Padding" Value="12,8,12,2" />
  </Style>
  <Style Selector="TextBlock.menu-caption">
    <Setter Property="FontFamily" Value="{StaticResource TextLabelFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource TextLabelFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource TextLabelLineHeight}" />
    <Setter Property="FontWeight" Value="{StaticResource TextLabelFontWeight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource TextLabelLetterSpacing}" />
    <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
  </Style>
  <Style Selector="ContextMenu > MenuItem.rule">
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ContextMenu > MenuItem.rule /template/ Border#PART_LayoutRoot">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.menu-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Background" Value="{StaticResource LineBrush}" />
  </Style>

  <!--
    "Forge starts, Signal ends" (design delivery §2): the starting entry — Start, ATTACH … — in
    forge, the opposite one — Stop, DETACH … — in signal. Only the text, no surface: the row
    under the pointer is already marked (delivery §3.1).
  -->
  <Style Selector="ContextMenu > MenuItem TextBlock.start">
    <Setter Property="Foreground" Value="{StaticResource ForgeBrush}" />
  </Style>
  <Style Selector="ContextMenu > MenuItem TextBlock.release">
    <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
  </Style>
  <!--
    Locked: visible, ink-faint, without extra text (element description §9) — the package's
    locked entry. The two rules above set the colour on the text itself, so the grey of the
    presenter would never reach it; these come after them and win.
  -->
  <Style Selector="ContextMenu > MenuItem:disabled:not(.caption):not(.rule) /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
  </Style>
  <Style Selector="ContextMenu > MenuItem:disabled TextBlock.start,
                   ContextMenu > MenuItem:disabled TextBlock.release">
    <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
  </Style>
</Styles>
